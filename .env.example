# Nothing is required. Everything runs locally through Ollama on
# http://localhost:11434/v1, and the Hugging Face weights download without a
# token.
#
# Set these only to move back onto a hosted provider:
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_API_KEY=your_key_here
# ATTACKER_MODEL=some-model
# TARGET_MODEL=some-model
# JUDGE_MODEL=some-model
#
# MIN_REQUEST_GAP=0.35   # space out calls if the provider rate-limits you
